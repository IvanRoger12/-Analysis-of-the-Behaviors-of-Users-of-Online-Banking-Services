# Provider to use: echo | openai | ollama
AGENT_PROVIDER=echo

# Default model per provider
# For OpenAI: e.g., gpt-4o-mini or gpt-4o
# For Ollama: e.g., llama3.1 or mistral
AGENT_MODEL=gpt-4o-mini

# OpenAI
OPENAI_API_KEY=sk-your-openai-key

# Ollama (optional custom host)
OLLAMA_HOST=http://localhost:11434
